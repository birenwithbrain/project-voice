# Copy this file to .env for Docker Compose or to the relevant app directory
# for local development. Do not commit real credentials.

# Application
VOICE_COACH_ENVIRONMENT=development
VOICE_COACH_LOG_LEVEL=INFO

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# API
VOICE_COACH_API_CORS_ORIGINS=http://localhost:3000

# Database — required for Phase 2 onward. Use a strong, unique password outside local development.
VOICE_COACH_DATABASE_URL=postgresql+psycopg://voice_coach:change-me@localhost:5432/voice_coach
POSTGRES_DB=voice_coach
POSTGRES_USER=voice_coach
POSTGRES_PASSWORD=change-me

# Gemini coaching sends transcript text and deterministic metrics only, after in-app consent.
# Confirm a model ID is available to your Google AI Studio API key before setting it.
VOICE_COACH_GEMINI_API_KEY=
VOICE_COACH_GEMINI_MODEL=
